---
import type { CollectionEntry } from 'astro:content';
import { productPath } from '../lib/products';
import { site } from '../lib/site';

interface Props {
    products?: CollectionEntry<'products'>[];
}

const { products = [] } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
        <div class="grid gap-10 sm:grid-cols-[1.5fr_1fr_1fr]">
            <div>
                <p class="text-base font-semibold tracking-tight text-white">{site.name}</p>
                <p class="mt-2 max-w-[36ch] text-sm leading-relaxed text-zinc-500">
                    {site.tagline}
                </p>
            </div>
            {
                products.length > 0 && (
                    <div>
                        <p class="text-sm font-medium text-zinc-300">产品</p>
                        <ul class="mt-3 space-y-2">
                            {products.map((p) => (
                                <li>
                                    <a
                                        href={productPath(p.id)}
                                        class="text-sm text-zinc-500 transition-colors hover:text-zinc-200"
                                    >
                                        {p.data.name}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                )
            }
            <div>
                <p class="text-sm font-medium text-zinc-300">相关</p>
                <ul class="mt-3 space-y-2">
                    <li>
                        <a
                            href={site.github}
                            target="_blank"
                            rel="noopener"
                            class="text-sm text-zinc-500 transition-colors hover:text-zinc-200"
                        >
                            GitHub
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        <p class="mt-10 text-xs text-zinc-600">© {year} {site.name}</p>
    </div>
</footer>
