---
import { site } from '../lib/site';

interface AnchorItem {
    label: string;
    href: string;
}

interface Props {
    mode: 'site' | 'product';
    productName?: string;
    anchors?: AnchorItem[];
    download?: { label: string; href: string; external?: boolean };
}

const { mode, productName, anchors = [], download } = Astro.props;
---

<header
    class="sticky top-0 z-40 border-b border-line bg-surface-0/80 backdrop-blur-md"
>
    <nav
        class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6"
        aria-label="主导航"
    >
        <div class="flex min-w-0 items-center gap-3">
            {
                mode === 'product' && (
                    <a
                        href="/"
                        class="inline-flex shrink-0 items-center gap-1.5 text-sm text-zinc-400 transition-colors hover:text-zinc-100"
                    >
                        <i class="ph ph-arrow-left text-base" aria-hidden="true" />
                        全部产品
                    </a>
                )
            }
            {
                mode === 'product' && productName && (
                    <>
                        <span class="hidden h-4 w-px bg-line sm:block" aria-hidden="true" />
                        <span class="hidden truncate text-sm font-medium text-zinc-100 sm:block">
                            {productName}
                        </span>
                    </>
                )
            }
            {
                mode === 'site' && (
                    <a href="/" class="text-base font-semibold tracking-tight text-white">
                        {site.name}
                    </a>
                )
            }
        </div>

        <div class="flex items-center gap-1 sm:gap-2">
            {
                anchors.map((a) => (
                    <a
                        href={a.href}
                        class="hidden rounded-full px-3 py-1.5 text-sm text-zinc-400 transition-colors hover:text-zinc-100 sm:block"
                    >
                        {a.label}
                    </a>
                ))
            }
            {
                download && (
                    <a
                        href={download.href}
                        {...(download.external ? { target: '_blank', rel: 'noopener' } : {})}
                        class="ml-1 inline-flex h-9 items-center rounded-full bg-accent-strong px-4 text-sm font-medium text-white transition hover:bg-accent active:scale-[0.98]"
                    >
                        {download.label}
                    </a>
                )
            }
            {
                mode === 'site' && (
                    <a
                        href={site.github}
                        target="_blank"
                        rel="noopener"
                        aria-label="GitHub"
                        class="inline-flex size-9 items-center justify-center rounded-full text-zinc-400 transition-colors hover:text-zinc-100"
                    >
                        <i class="ph ph-github-logo text-xl" aria-hidden="true" />
                    </a>
                )
            }
        </div>
    </nav>
</header>
