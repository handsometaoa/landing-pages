---
import type { CollectionEntry } from 'astro:content';

type Product = CollectionEntry<'products'>;
type Section = NonNullable<Product['data']['sections'][number]>;
type FeaturesSection = Extract<Section, { type: 'features' }>;

interface Props {
    section: FeaturesSection;
}

const { section } = Astro.props;
const { title, items } = section;

// Bento 节奏：6 格按 4+2 / 2+4 / 3+3 的跨度交替，超出时循环
const spans = [
    'lg:col-span-4',
    'lg:col-span-2',
    'lg:col-span-2',
    'lg:col-span-4',
    'lg:col-span-3',
    'lg:col-span-3',
];
---

<section id="features" class="scroll-mt-24 py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2
            class="max-w-[52ch] text-3xl font-bold tracking-tight text-white md:text-4xl"
            data-reveal
        >
            {title}
        </h2>
        <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-6">
            {
                items.map((item, i) => (
                    <div
                        class={`rounded-2xl border border-line p-6 md:p-7 ${
                            item.tint
                                ? 'border-accent/20 bg-gradient-to-br from-accent/12 via-surface-1 to-surface-1'
                                : 'bg-surface-1'
                        } ${spans[i % spans.length]}`}
                        data-reveal
                        style={`--reveal-delay: ${(i % 3) * 70}ms`}
                    >
                        <div class="inline-flex size-11 items-center justify-center rounded-xl bg-accent/12 text-accent">
                            <i class={`ph ph-${item.icon} text-2xl`} aria-hidden="true" />
                        </div>
                        <h3 class="mt-5 text-lg font-semibold text-white">{item.title}</h3>
                        <p class="mt-2 text-sm leading-relaxed text-zinc-400">{item.desc}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
