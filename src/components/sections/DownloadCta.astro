---
import type { CollectionEntry } from 'astro:content';

type Product = CollectionEntry<'products'>;
type Section = NonNullable<Product['data']['sections'][number]>;
type DownloadSection = Extract<Section, { type: 'download' }>;

interface Props {
    section: DownloadSection;
}

const { section } = Astro.props;
const { title, sub, primaryCta, secondaryCta, notes } = section;
---

<section id="download" class="scroll-mt-24 py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div
            class="relative overflow-hidden rounded-3xl border border-line bg-gradient-to-b from-accent/10 to-surface-1 px-6 py-14 text-center md:py-20"
            data-reveal
        >
            <div
                class="pointer-events-none absolute -top-32 left-1/2 h-[380px] w-[520px] -translate-x-1/2 rounded-full bg-accent-strong/15 blur-[100px]"
                aria-hidden="true"
            >
            </div>

            <div class="relative">
                <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">
                    {title}
                </h2>
                {sub && <p class="mx-auto mt-4 max-w-[46ch] text-zinc-400">{sub}</p>}

                <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
                    <a
                        href={primaryCta.href}
                        {...(primaryCta.external ? { target: '_blank', rel: 'noopener' } : {})}
                        class="inline-flex h-12 items-center gap-2 rounded-full bg-accent-strong px-7 text-base font-medium text-white transition hover:bg-accent active:scale-[0.98]"
                    >
                        <i class="ph ph-download-simple text-lg" aria-hidden="true"></i>
                        {primaryCta.label}
                    </a>
                    {
                        secondaryCta && (
                            <a
                                href={secondaryCta.href}
                                {...(secondaryCta.external
                                    ? { target: '_blank', rel: 'noopener' }
                                    : {})}
                                class="inline-flex h-12 items-center gap-2 rounded-full border border-line px-7 text-base text-zinc-200 transition hover:border-white/20 hover:bg-white/5 active:scale-[0.98]"
                            >
                                <i class="ph ph-github-logo text-lg" aria-hidden="true" />
                                {secondaryCta.label}
                            </a>
                        )
                    }
                </div>

                {
                    notes.length > 0 && (
                        <ul class="mx-auto mt-9 max-w-md space-y-2.5 text-left">
                            {notes.map((note) => (
                                <li class="flex gap-2.5 text-sm text-zinc-500">
                                    <i
                                        class="ph ph-check mt-0.5 shrink-0 text-accent"
                                        aria-hidden="true"
                                    />
                                    <span>{note}</span>
                                </li>
                            ))}
                        </ul>
                    )
                }
            </div>
        </div>
    </div>
</section>
