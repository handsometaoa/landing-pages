---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { productImage } from '../../lib/products';

type Product = CollectionEntry<'products'>;
type Section = NonNullable<Product['data']['sections'][number]>;
type HeroSection = Extract<Section, { type: 'hero' }>;

interface Props {
    section: HeroSection;
    product: Product;
}

const { section, product } = Astro.props;
const { headline, sub, primaryCta, secondaryCta, image } = section;
const { name } = product.data;

// 竖版截图走左文右图的分栏；横版截图走上文下图，图片横贯整个内容区
const img = productImage(product.id, image);
const landscape = img.width >= img.height;
const imgSrc = img;
---

<section class="relative overflow-hidden">
    <!-- 品牌色光晕：贴合并衬托应用截图 -->
    <div
        class="pointer-events-none absolute -top-40 right-[-10%] h-[560px] w-[560px] rounded-full opacity-25 blur-[120px]"
        style="background: radial-gradient(circle, #2f6ff5 0%, transparent 65%)"
        aria-hidden="true"
    >
    </div>

    {
        landscape ? (
            <div class="mx-auto max-w-6xl px-4 pt-16 pb-16 sm:px-6 md:pt-24 md:pb-24">
                <h1
                    class="rise max-w-[26ch] text-4xl leading-[1.15] font-bold tracking-tight text-white sm:text-5xl lg:text-6xl"
                    style="--rise-delay: 0ms"
                >
                    {headline}
                </h1>
                <p
                    class="rise mt-5 max-w-[52ch] text-base leading-relaxed text-zinc-400 sm:text-lg"
                    style="--rise-delay: 90ms"
                >
                    {sub}
                </p>
                <div
                    class="rise mt-8 flex flex-wrap items-center gap-3"
                    style="--rise-delay: 180ms"
                >
                    <a
                        href={primaryCta.href}
                        {...(primaryCta.external ? { target: '_blank', rel: 'noopener' } : {})}
                        class="inline-flex h-12 items-center gap-2 rounded-full bg-accent-strong px-6 text-base font-medium text-white transition hover:bg-accent active:scale-[0.98]"
                    >
                        <i class="ph ph-download-simple text-lg" aria-hidden="true" />
                        {primaryCta.label}
                    </a>
                    {secondaryCta && (
                        <a
                            href={secondaryCta.href}
                            {...(secondaryCta.external
                                ? { target: '_blank', rel: 'noopener' }
                                : {})}
                            class="inline-flex h-12 items-center gap-2 rounded-full border border-line px-6 text-base text-zinc-200 transition hover:border-white/20 hover:bg-white/5 active:scale-[0.98]"
                        >
                            <i class="ph ph-github-logo text-lg" aria-hidden="true" />
                            {secondaryCta.label}
                        </a>
                    )}
                </div>
                <div class="rise relative mt-12" style="--rise-delay: 140ms">
                    <div
                        class="pointer-events-none absolute top-1/2 left-1/2 h-[60%] w-[80%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-strong/15 blur-3xl"
                        aria-hidden="true"
                    />
                    <div class="relative rounded-2xl border border-line bg-surface-1 p-2 shadow-2xl shadow-accent-deep/20">
                        <Image
                            src={imgSrc}
                            alt={`${name} 实际效果截图`}
                            widths={[640, 960, 1280, 1600]}
                            sizes="(min-width: 1152px) 1088px, 100vw"
                            class="h-auto w-full rounded-xl"
                            loading="eager"
                            fetchpriority="high"
                        />
                    </div>
                </div>
            </div>
        ) : (
            <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-16 pb-16 sm:px-6 md:pt-24 md:pb-24 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
                <div>
                    <h1
                        class="rise text-4xl leading-[1.15] font-bold tracking-tight text-white sm:text-5xl lg:text-6xl"
                        style="--rise-delay: 0ms"
                    >
                        {headline}
                    </h1>
                    <p
                        class="rise mt-5 max-w-[42ch] text-base leading-relaxed text-zinc-400 sm:text-lg"
                        style="--rise-delay: 90ms"
                    >
                        {sub}
                    </p>
                    <div
                        class="rise mt-8 flex flex-wrap items-center gap-3"
                        style="--rise-delay: 180ms"
                    >
                        <a
                            href={primaryCta.href}
                            {...(primaryCta.external
                                ? { target: '_blank', rel: 'noopener' }
                                : {})}
                            class="inline-flex h-12 items-center gap-2 rounded-full bg-accent-strong px-6 text-base font-medium text-white transition hover:bg-accent active:scale-[0.98]"
                        >
                            <i class="ph ph-download-simple text-lg" aria-hidden="true" />
                            {primaryCta.label}
                        </a>
                        {secondaryCta && (
                            <a
                                href={secondaryCta.href}
                                {...(secondaryCta.external
                                    ? { target: '_blank', rel: 'noopener' }
                                    : {})}
                                class="inline-flex h-12 items-center gap-2 rounded-full border border-line px-6 text-base text-zinc-200 transition hover:border-white/20 hover:bg-white/5 active:scale-[0.98]"
                            >
                                <i class="ph ph-github-logo text-lg" aria-hidden="true" />
                                {secondaryCta.label}
                            </a>
                        )}
                    </div>
                </div>

                <div class="rise relative" style="--rise-delay: 140ms">
                    <div
                        class="pointer-events-none absolute top-1/2 left-1/2 h-[70%] w-[70%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-strong/20 blur-3xl"
                        aria-hidden="true"
                    />
                    <div class="relative mx-auto w-fit rounded-2xl border border-line bg-surface-1 p-2 shadow-2xl shadow-accent-deep/20">
                        <Image
                            src={imgSrc}
                            alt={`${name} 界面截图`}
                            widths={[280, 400, 560]}
                            sizes="(min-width: 1024px) 400px, 80vw"
                            class="h-[440px] w-auto rounded-xl sm:h-[500px]"
                            loading="eager"
                            fetchpriority="high"
                        />
                    </div>
                </div>
            </div>
        )
    }
</section>
